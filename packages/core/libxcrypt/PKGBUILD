# Maintainer: Only Linux Project

pkgname=libxcrypt
pkgver=4.5.2
pkgrel=1
pkgdesc="Modern library for one-way hashing of passwords"
arch=('x86_64')
url="https://github.com/besser82/libxcrypt"
license=('LGPL-2.1-or-later')
depends=('glibc')
options=('!debug')
source=("https://github.com/besser82/libxcrypt/releases/download/v${pkgver}/libxcrypt-${pkgver}.tar.xz")
md5sums=('25e888919ddcd153a07daa95224fa436')

prepare() {
  cd "${srcdir}/libxcrypt-${pkgver}"

  # Match the upstream fix for newer compilers that diagnose the const cast.
  sed -i 's/(const char \*) intbuf->retval/(char *) intbuf->retval/' \
    lib/crypt-gost-yescrypt.c \
    lib/crypt-sm3-yescrypt.c
}

build() {
  cd "${srcdir}/libxcrypt-${pkgver}"
  ./configure \
    --prefix=/usr \
    --enable-hashes=strong,glibc \
    --enable-obsolete-api=no \
    --disable-static
  make
}

check() {
  cd "${srcdir}/libxcrypt-${pkgver}"
  make check
}

package() {
  cd "${srcdir}/libxcrypt-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
