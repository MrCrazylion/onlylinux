pkgname=automake
pkgver=1.18.1
pkgrel=1
pkgdesc="GNU tool for automatically generating Makefiles"
arch=('any')
url="https://www.gnu.org/software/automake/"
license=('GPL-2.0-or-later')
depends=('autoconf' 'perl')
options=('!debug')
source=("https://ftp.gnu.org/gnu/automake/automake-${pkgver}.tar.xz")
md5sums=('cea31dbf1120f890cbf2a3032cfb9a68')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr
  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="$pkgdir" install
}
