pkgname=flit-core
pkgver=3.12.0
pkgrel=1
pkgdesc="Distribution-building parts of Flit"
arch=('any')
url="https://flit.pypa.io/"
license=('BSD-3-Clause')
depends=('python')
makedepends=('python-pip')
source=("https://pypi.org/packages/source/f/flit-core/flit_core-$pkgver.tar.gz")
md5sums=('c538415c1f27bd69cbbbf3cdd5135d39')

build() {
  cd "flit_core-$pkgver"
  python -m pip wheel -w dist --no-cache-dir --no-build-isolation --no-deps .
}

package() {
  cd "flit_core-$pkgver"
  python -m pip install --root="$pkgdir" --no-index --find-links=dist --no-deps flit_core
}
