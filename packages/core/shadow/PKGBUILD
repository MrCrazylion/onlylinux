pkgname=shadow
pkgver=4.19.3
pkgrel=1
pkgdesc="Password and account management utilities"
arch=('x86_64')
url="https://github.com/shadow-maint/shadow"
license=('BSD-3-Clause')
depends=('glibc' 'pam' 'libxcrypt')
options=('!debug')
source=("https://github.com/shadow-maint/shadow/releases/download/${pkgver}/shadow-${pkgver}.tar.xz")
md5sums=('c56d98c09e5dbae816250ba5c2285a37')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static --without-libbsd --with-group-name-max-length=32
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="$pkgdir" install
}
