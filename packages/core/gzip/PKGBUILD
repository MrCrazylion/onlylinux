# Maintainer: Only Linux Project

pkgname=gzip
pkgver=1.14
pkgrel=1
pkgdesc="GNU compression utility"
arch=('x86_64')
url="https://www.gnu.org/software/gzip/"
license=('GPL-3.0-or-later')
depends=('glibc')
options=('!debug')
source=("https://mirrors.kernel.org/gnu/gzip/gzip-${pkgver}.tar.xz")
md5sums=('4bf5a10f287501ee8e8ebe00ef62b2c2')

build() {
  cd "${srcdir}/gzip-${pkgver}"
  ./configure --prefix=/usr
  make
}

check() {
  cd "${srcdir}/gzip-${pkgver}"
  make check
}

package() {
  cd "${srcdir}/gzip-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
