pkgname=linux
pkgver=6.18.10
pkgrel=1
pkgdesc="Linux kernel"
arch=('x86_64')
url="https://www.kernel.org/"
license=('GPL-2.0-only')
makedepends=('bc' 'bison' 'elfutils' 'flex' 'kmod' 'openssl' 'perl')
source=("https://www.kernel.org/pub/linux/kernel/v6.x/linux-$pkgver.tar.xz")
md5sums=('660e706a43f634b1fcd911f8839d2f61')

prepare() {
  cd "$pkgname-$pkgver"
  make mrproper
}

build() {
  cd "$pkgname-$pkgver"
  make defconfig
  scripts/config --disable WERROR \
    --enable PSI --disable PSI_DEFAULT_DISABLED \
    --enable CGROUPS --enable MEMCG --enable CGROUP_SCHED --disable RT_GROUP_SCHED \
    --enable RELOCATABLE --enable RANDOMIZE_BASE \
    --enable STACKPROTECTOR --enable STACKPROTECTOR_STRONG \
    --enable NET --enable INET --enable IPV6 \
    --disable UEVENT_HELPER --enable DEVTMPFS --enable DEVTMPFS_MOUNT \
    --module FW_LOADER --disable FW_LOADER_USER_HELPER \
    --enable DMIID --enable SYSFB_SIMPLEFB \
    --enable DRM --enable DRM_PANIC --enable DRM_FBDEV_EMULATION \
    --enable DRM_SIMPLEDRM --enable FRAMEBUFFER_CONSOLE \
    --enable INOTIFY_USER --enable TMPFS --enable TMPFS_POSIX_ACL \
    --enable X86_X2APIC --enable PCI --enable PCI_MSI \
    --enable IOMMU_SUPPORT --enable IRQ_REMAP
  scripts/config --set-str DRM_PANIC_SCREEN kmsg
  make olddefconfig
  make
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm644 arch/x86/boot/bzImage "$pkgdir/boot/vmlinuz-$pkgver"
  install -Dm644 System.map "$pkgdir/boot/System.map-$pkgver"
  install -Dm644 .config "$pkgdir/boot/config-$pkgver"
  make INSTALL_MOD_PATH="$pkgdir/usr" modules_install
  mkdir -p "$pkgdir/usr/share/doc"
  cp -a Documentation "$pkgdir/usr/share/doc/linux-$pkgver"
  install -Dm644 /dev/stdin "$pkgdir/etc/modprobe.d/usb.conf" <<'EOF'
# Begin /etc/modprobe.d/usb.conf

install ohci_hcd /sbin/modprobe ehci_hcd ; /sbin/modprobe -i ohci_hcd ; true
install uhci_hcd /sbin/modprobe ehci_hcd ; /sbin/modprobe -i uhci_hcd ; true

# End /etc/modprobe.d/usb.conf
EOF
}
