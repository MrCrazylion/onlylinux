pkgname=lz4
pkgver=1.10.0
pkgrel=1
pkgdesc="Extremely fast compression algorithm"
arch=('x86_64')
url="https://lz4.github.io/lz4/"
license=('BSD-2-Clause')
source=("https://github.com/lz4/lz4/archive/v${pkgver}/lz4-${pkgver}.tar.gz")
md5sums=('dead9f5f1966d9ae56e1e32761e4e675')
build() { cd "lz4-${pkgver}"; make BUILD_STATIC=no; }
package() { cd "lz4-${pkgver}"; make PREFIX=/usr DESTDIR="$pkgdir" install; }
