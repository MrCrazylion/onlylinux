# Maintainer: Only Linux Project

pkgname=ncurses
pkgver=6.6
pkgrel=1
pkgdesc="System V curses emulation library"
arch=('x86_64')
url="https://invisible-island.net/ncurses/"
license=('MIT')
depends=('glibc' 'gcc-libs')
provides=('libncurses++w.so' 'libformw.so' 'libmenuw.so' 'libpanelw.so' 'libncursesw.so')
options=('!debug')
source=("https://invisible-mirror.net/archives/ncurses/ncurses-${pkgver}.tar.gz")
md5sums=('dd45bf6854430af403452a7a6a40652c')

build() {
  cd "${srcdir}/ncurses-${pkgver}"
  ./configure \
    --prefix=/usr \
    --enable-widec \
    --enable-pc-files \
    --mandir=/usr/share/man \
    --with-cxx-binding \
    --with-cxx-shared \
    --with-manpage-format=normal \
    --with-pkg-config-libdir=/usr/lib/pkgconfig \
    --with-shared \
    --with-versioned-syms \
    --with-xterm-kbs=del \
    --without-ada \
    --without-debug \
    --without-normal
  make
}

package() {
  cd "${srcdir}/ncurses-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"

  for library in ncurses ncurses++ form panel menu; do
    printf 'INPUT(-l%sw)\n' "${library}" > "${pkgdir}/usr/lib/lib${library}.so"
    ln -s "${library}w.pc" "${pkgdir}/usr/lib/pkgconfig/${library}.pc"
  done

  printf 'INPUT(-lncursesw)\n' > "${pkgdir}/usr/lib/libcursesw.so"
  ln -s libncurses.so "${pkgdir}/usr/lib/libcurses.so"

  for library in tic tinfo; do
    printf 'INPUT(libncursesw.so.%s)\n' "${pkgver:0:1}" > "${pkgdir}/usr/lib/lib${library}.so"
    ln -s "libncursesw.so.${pkgver:0:1}" "${pkgdir}/usr/lib/lib${library}.so.${pkgver:0:1}"
    ln -s ncursesw.pc "${pkgdir}/usr/lib/pkgconfig/${library}.pc"
  done
}
