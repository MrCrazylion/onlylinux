pkgname=expect
pkgver=5.45.4
pkgrel=2
pkgdesc="Tool for automating interactive applications"
arch=('x86_64')
url="https://core.tcl-lang.org/expect/"
license=('Public-Domain')
depends=('tcl')
source=(
  "expect${pkgver}.tar.gz::https://prdownloads.sourceforge.net/expect/expect${pkgver}.tar.gz"
  "expect-${pkgver}-gcc15-1.patch::https://www.linuxfromscratch.org/patches/lfs/13.0/expect-${pkgver}-gcc15-1.patch"
)
md5sums=(
  '00fce8de158422f5ccd2666512329bd2'
  '0ca4d6bb8d572fbcdb13cb36cd34833e'
)

prepare() {
  cd "expect${pkgver}"
  patch -Np1 -i "../expect-${pkgver}-gcc15-1.patch"
}

build() {
  cd "expect${pkgver}"
  ./configure \
    --prefix=/usr \
    --with-tcl=/usr/lib \
    --enable-shared \
    --disable-rpath \
    --mandir=/usr/share/man \
    --with-tclinclude=/usr/include
  make
}

package() {
  cd "expect${pkgver}"
  make DESTDIR="${pkgdir}" install
  ln -s "expect${pkgver}/libexpect${pkgver}.so" "${pkgdir}/usr/lib/libexpect${pkgver}.so"
}
