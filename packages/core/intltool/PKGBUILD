pkgname=intltool
pkgver=0.51.0
pkgrel=1
pkgdesc="Internationalization tools for extracting translatable strings"
arch=('x86_64')
url="https://freedesktop.org/wiki/Software/intltool/"
license=('GPL-2.0-or-later')
depends=('perl' 'perl-xml-parser')
options=('!debug')
source=("https://launchpad.net/intltool/trunk/${pkgver}/+download/intltool-${pkgver}.tar.gz")
md5sums=('12e517cac2b57a0121cda351570f1e63')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="$pkgdir" install
}
