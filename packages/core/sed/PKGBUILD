# Maintainer: Only Linux Project

pkgname=sed
pkgver=4.9
pkgrel=1
pkgdesc="GNU stream editor"
arch=('x86_64')
url="https://www.gnu.org/software/sed/"
license=('GPL-3.0-or-later')
depends=('glibc' 'acl')
options=('!debug')
source=("https://mirrors.kernel.org/gnu/sed/sed-${pkgver}.tar.xz")
md5sums=('6aac9b2dbafcd5b7a67a8a9bcb8036c3')

build() {
  cd "${srcdir}/sed-${pkgver}"
  ./configure --prefix=/usr
  make
}

check() {
  cd "${srcdir}/sed-${pkgver}"
  make check
}

package() {
  cd "${srcdir}/sed-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
