# Maintainer: Only Linux Project

pkgname=file
pkgver=5.46
pkgrel=1
pkgdesc="File type identification utility and libmagic"
arch=('x86_64')
url="https://www.darwinsys.com/file/"
license=('BSD-2-Clause')
depends=('glibc' 'zlib' 'xz' 'bzip2' 'zstd')
provides=('libmagic.so')
options=('!debug' '!emptydirs')
source=("https://astron.com/pub/file/file-${pkgver}.tar.gz")
md5sums=('459da2d4b534801e2e2861611d823864')

build() {
  cd "${srcdir}/file-${pkgver}"
  CFLAGS+=" -pthread"
  ./configure --prefix=/usr --datadir=/usr/share/file --enable-fsect-man5 --disable-libseccomp
  make
}

check() {
  cd "${srcdir}/file-${pkgver}"
  make check
}

package() {
  cd "${srcdir}/file-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
