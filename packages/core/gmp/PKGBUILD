pkgname=gmp
pkgver=6.3.0
pkgrel=1
pkgdesc="A free library for arbitrary precision arithmetic"
arch=('x86_64')
url="https://gmplib.org/"
license=('GPL-2.0-or-later' 'LGPL-3.0-or-later')
depends=('glibc')
options=('!debug')
source=("https://ftpmirror.gnu.org/gmp/gmp-${pkgver}.tar.xz")
md5sums=('956dc04e864001a9c22429f761f2c283')

prepare() {
  cd "${pkgname}-${pkgver}"
  sed -i '/long long t1;/,+1s/()/(...)/' configure
}

build() {
  cd "${pkgname}-${pkgver}"
  ./configure \
    --build=x86_64-pc-linux-gnu \
    --prefix=/usr \
    --enable-cxx \
    --enable-fat \
    --disable-static \
    --docdir="/usr/share/doc/${pkgname}-${pkgver}"
  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
