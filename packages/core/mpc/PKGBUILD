pkgname=mpc
pkgver=1.3.1
pkgrel=1
pkgdesc="Library for arithmetic of complex numbers with arbitrary precision"
arch=('x86_64')
url="https://www.multiprecision.org/mpc/"
license=('LGPL-3.0-or-later')
depends=('glibc' 'gmp' 'mpfr')
options=('!debug')
source=("https://ftpmirror.gnu.org/mpc/mpc-${pkgver}.tar.gz")
md5sums=('5c9bc658c9fd0f940e8e3e0f09530c62')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr --disable-static
  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
