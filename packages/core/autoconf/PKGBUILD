pkgname=autoconf
pkgver=2.72
pkgrel=1
pkgdesc="GNU tool for automatically configuring source code"
arch=('any')
url="https://www.gnu.org/software/autoconf/"
license=('GPL-3.0-or-later')
depends=('m4' 'perl')
options=('!debug')
source=("https://ftp.gnu.org/gnu/autoconf/autoconf-${pkgver}.tar.xz")
md5sums=('1be79f7106ab6767f18391c5e22be701')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr
  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="$pkgdir" install
}
