pkgname=markupsafe
pkgver=3.0.3
pkgrel=1
pkgdesc="Safely add untrusted strings to HTML/XML markup"
arch=('x86_64')
url="https://palletsprojects.com/p/markupsafe/"
license=('BSD-3-Clause')
depends=('python')
makedepends=('python-pip' 'setuptools' 'wheel')
source=("https://pypi.org/packages/source/m/markupsafe/markupsafe-$pkgver.tar.gz")
md5sums=('13a73126d25afa72a1ff0daed072f5fe')

build() {
  cd "$pkgname-$pkgver"
  python -m pip wheel -w dist --no-cache-dir --no-build-isolation --no-deps .
}

package() {
  cd "$pkgname-$pkgver"
  python -m pip install --root="$pkgdir" --no-index --find-links=dist --no-deps MarkupSafe
}
