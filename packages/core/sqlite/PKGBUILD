pkgname=sqlite
pkgver=3510200
pkgrel=1
pkgdesc="C library that implements a small SQL database engine"
arch=('x86_64')
url="https://www.sqlite.org/"
license=('LicenseRef-Public-Domain')
depends=('glibc' 'readline' 'zlib')
options=('!debug')
source=("https://www.sqlite.org/2026/sqlite-autoconf-${pkgver}.tar.gz")
md5sums=('005159be74cf46222d6399fbc0fb0ada')

build() {
  cd "sqlite-autoconf-${pkgver}"
  ./configure --prefix=/usr --disable-static --enable-fts5
  make
}

package() {
  cd "sqlite-autoconf-${pkgver}"
  make DESTDIR="$pkgdir" install
}
