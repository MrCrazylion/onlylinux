# Maintainer: Only Linux Project

pkgname=readline
pkgver=8.3
pkgrel=1
pkgdesc="GNU command-line editing and history libraries"
arch=('x86_64')
url="https://tiswww.case.edu/php/chet/readline/rltop.html"
license=('GPL-3.0-or-later')
depends=('glibc' 'ncurses' 'libncursesw.so')
provides=('libhistory.so' 'libreadline.so')
options=('!debug' '!emptydirs')
source=("https://ftpmirror.gnu.org/readline/readline-${pkgver}.tar.gz")
md5sums=('25a73bfb2a3ad7146c5e9d4408d9f6cd')

prepare() {
  cd "${srcdir}/readline-${pkgver}"
  sed -i 's|-Wl,-rpath,$(libdir) ||g' support/shobj-conf
}

build() {
  cd "${srcdir}/readline-${pkgver}"
  CFLAGS+=" -fPIC"
  ./configure --prefix=/usr
  make SHLIB_LIBS=-lncursesw
}

check() {
  cd "${srcdir}/readline-${pkgver}"
  make check
}

package() {
  cd "${srcdir}/readline-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
