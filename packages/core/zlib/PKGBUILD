# Maintainer: Only Linux Project

pkgname=zlib
pkgver=1.3.2
pkgrel=2
pkgdesc="Compression library implementing the deflate algorithm"
arch=('x86_64')
url="https://zlib.net/"
license=('Zlib')
depends=('glibc')
makedepends=('git')
options=('!debug')
source=("zlib::git+https://github.com/madler/zlib.git#commit=da607da739fa6047df13e66a2af6b8bec7c2a498")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/zlib"
  ./configure --prefix=/usr
  make
}

package() {
  cd "${srcdir}/zlib"
  make DESTDIR="${pkgdir}" install
}
