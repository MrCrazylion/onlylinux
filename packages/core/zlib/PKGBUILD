# Maintainer: Only Linux Project

pkgname=zlib
pkgver=1.3.2
pkgrel=1
pkgdesc="Compression library implementing the deflate algorithm"
arch=('x86_64')
url="https://zlib.net/"
license=('Zlib')
depends=('glibc')
options=('!debug')
source=("https://zlib.net/fossils/zlib-${pkgver}.tar.gz")
md5sums=('a1e6c958597af3c67d162995a342138a')

build() {
  cd "${srcdir}/zlib-${pkgver}"
  ./configure --prefix=/usr
  make
}

package() {
  cd "${srcdir}/zlib-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
