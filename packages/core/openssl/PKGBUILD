pkgname=openssl
pkgver=3.6.1
pkgrel=1
pkgdesc="Toolkit for Transport Layer Security"
arch=('x86_64')
url="https://www.openssl.org/"
license=('Apache-2.0')
depends=('glibc')
options=('!debug')
source=("https://www.openssl.org/source/openssl-${pkgver}.tar.gz")
md5sums=('589777dc85ebbfeca70161c0c384d572')

build() {
  cd "${pkgname}-${pkgver}"
  ./Configure --prefix=/usr --openssldir=/etc/ssl --libdir=lib shared
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="$pkgdir" install_sw
}
