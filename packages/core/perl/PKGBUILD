pkgname=perl
pkgver=5.42.0
pkgrel=1
pkgdesc="Highly capable, feature-rich programming language"
arch=('x86_64')
url="https://www.perl.org/"
license=('GPL-1.0-or-later' 'Artistic-1.0-Perl')
depends=('glibc' 'gdbm' 'zlib')
options=('!debug')
source=("https://www.cpan.org/src/5.0/perl-${pkgver}.tar.xz")
md5sums=('7a6950a9f12d01eb96a9d2ed2f4e0072')

build() {
  cd "${pkgname}-${pkgver}"
  sh Configure -des -D prefix=/usr -D vendorprefix=/usr -D useshrplib
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="$pkgdir" install
}
