pkgname=binutils
pkgver=2.46.0
pkgrel=1
pkgdesc="Programs for assembling and manipulating binary and object files"
arch=('x86_64')
url="https://www.gnu.org/software/binutils/"
license=('GPL-3.0-or-later' 'LGPL-3.0-or-later')
depends=('glibc' 'zlib' 'zstd')
makedepends=('bison' 'flex')
options=('!debug')
source=("https://sourceware.org/pub/binutils/releases/binutils-${pkgver}.tar.xz")
md5sums=('81bb6810bcd1119819dc0804956e1c92')

build() {
  cd "${pkgname}-${pkgver}"
  mkdir -p build
  cd build
  ../configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-ld=default \
    --enable-plugins \
    --enable-shared \
    --disable-werror \
    --enable-64-bit-bfd \
    --enable-new-dtags \
    --with-system-zlib \
    --enable-default-hash-style=gnu
  make tooldir=/usr
}

check() {
  cd "${pkgname}-${pkgver}/build"
  make -k check
}

package() {
  cd "${pkgname}-${pkgver}/build"
  make DESTDIR="$pkgdir" tooldir=/usr install
  rm -f "$pkgdir"/usr/lib/lib{bfd,ctf,ctf-nobfd,gprofng,opcodes,sframe}.a
  rm -rf "$pkgdir/usr/share/doc/gprofng"
}
