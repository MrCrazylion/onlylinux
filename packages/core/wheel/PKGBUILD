pkgname=wheel
pkgver=0.46.3
pkgrel=1
pkgdesc="Python built-package format"
arch=('any')
url="https://wheel.readthedocs.io/"
license=('MIT')
depends=('python' 'packaging')
makedepends=('python-pip' 'flit-core')
source=("https://pypi.org/packages/source/w/wheel/wheel-$pkgver.tar.gz")
md5sums=('61fb0c9633fe7492933a8f338db23508')

build() {
  cd "$pkgname-$pkgver"
  python -m pip wheel -w dist --no-cache-dir --no-build-isolation --no-deps .
}

package() {
  cd "$pkgname-$pkgver"
  python -m pip install --root="$pkgdir" --no-index --find-links=dist --no-deps wheel
}
