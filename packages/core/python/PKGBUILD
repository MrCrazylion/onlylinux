pkgname=python
pkgver=3.14.3
pkgrel=1
pkgdesc="Python programming language"
arch=('x86_64')
url="https://www.python.org/"
license=('PSF-2.0')
depends=('glibc' 'expat' 'openssl' 'zlib' 'bzip2' 'xz')
source=("https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz")
md5sums=('ef513dcb836d219ae0e2b16ac9c87d0f')

build() {
  cd "Python-$pkgver"
  ./configure \
    --prefix=/usr \
    --enable-shared \
    --with-system-expat \
    --enable-optimizations
  make
}

package() {
  cd "Python-$pkgver"
  make DESTDIR="$pkgdir" install
}
