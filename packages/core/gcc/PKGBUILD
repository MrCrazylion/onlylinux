pkgname=gcc
pkgver=15.2.0
pkgrel=1
pkgdesc="GNU Compiler Collection"
arch=('x86_64')
url="https://gcc.gnu.org/"
license=('GPL-3.0-or-later')
depends=('glibc' 'zlib' 'zstd')
makedepends=('gmp' 'mpfr' 'mpc' 'binutils')
source=("https://ftp.gnu.org/gnu/gcc/gcc-$pkgver/gcc-$pkgver.tar.xz")
md5sums=('b861b092bf1af683c46a8aa2e689a6fd')

prepare() {
  cd "$pkgname-$pkgver"
  sed -i 's/char [*]q/const &/' libgomp/affinity-fmt.c
  case $(uname -m) in
    x86_64) sed -e '/m64=/s/lib64/lib/' -i.orig gcc/config/i386/t-linux64 ;;
  esac
}

build() {
  cd "$pkgname-$pkgver"
  mkdir -p build
  cd build
  ../configure \
    --prefix=/usr \
    LD=ld \
    --enable-languages=c,c++ \
    --enable-default-pie \
    --enable-default-ssp \
    --enable-host-pie \
    --disable-multilib \
    --disable-bootstrap \
    --disable-fixincludes \
    --with-system-zlib
  make
}

package() {
  cd "$pkgname-$pkgver/build"
  make DESTDIR="$pkgdir" install
  ln -sf gcc "$pkgdir/usr/bin/cc"
  ln -sfr "$pkgdir/usr/bin/cpp" "$pkgdir/usr/lib/cpp"
  ln -sf gcc.1 "$pkgdir/usr/share/man/man1/cc.1"
  mkdir -p "$pkgdir/usr/lib/bfd-plugins"
  ln -sf "../../libexec/gcc/$(gcc -dumpmachine)/$pkgver/liblto_plugin.so" \
    "$pkgdir/usr/lib/bfd-plugins/liblto_plugin.so"
  mkdir -p "$pkgdir/usr/share/gdb/auto-load/usr/lib"
  shopt -s nullglob
  gdb_autoload=("$pkgdir"/usr/lib/*gdb.py)
  if (( ${#gdb_autoload[@]} )); then
    mv "${gdb_autoload[@]}" "$pkgdir/usr/share/gdb/auto-load/usr/lib/"
  fi
}
