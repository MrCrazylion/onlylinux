# Maintainer: Only Linux Project

pkgname=libcap
pkgver=2.77
pkgrel=1
pkgdesc="POSIX capabilities library and utilities"
arch=('x86_64')
url="https://sites.google.com/site/fullycapable/"
license=('BSD-3-Clause' 'GPL-2.0-only')
depends=('glibc' 'attr')
makedepends=('linux-api-headers')
options=('!debug')
source=("https://mirrors.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-${pkgver}.tar.xz")
md5sums=('58048c92f90ef8513c17fb9c24c2c1bd')

build() {
  cd "${srcdir}/libcap-${pkgver}"
  make prefix=/usr lib=lib
}

check() {
  cd "${srcdir}/libcap-${pkgver}"
  make test
}

package() {
  cd "${srcdir}/libcap-${pkgver}"
  make \
    DESTDIR="${pkgdir}" \
    prefix=/usr \
    lib=lib \
    RAISE_SETFCAP=no \
    install
  install -Dm644 License "${pkgdir}/usr/share/licenses/${pkgname}/License"
}
